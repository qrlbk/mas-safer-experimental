+        'HWID_Activation.cmd' { 'HWID' }
+        'Ohook_Activation_AIO.cmd' { 'Ohook' }
+        'TSforge_Activation.cmd' { 'TSforge' }
+        'Online_KMS_Activation.cmd' { 'KMS' }
