 :: Leave empty line below
+
+:: Embedded helper is called explicitly; never fall through into PowerShell text.
+exit /b
+:mas_safer_preflight
+set "MAS_SAFE_SELF=%~f0"
+set "MAS_SAFE_ACTION=validate"
+if defined isOspp set "MAS_SAFE_ACTION=validate-ospp"
+call :mas_safer_ohook
+if errorlevel 1 (set error=1&set ierror=Preflight&set mas_safer_ohook_failed=1&exit /b 1)
+exit /b 0
+:mas_safer_ohook
+%psc% "$ErrorActionPreference='Stop'; try { $f=[IO.File]::ReadAllText($env:MAS_SAFE_SELF) -split '(?m)^:saferohook:\r?$'; if ($f.Count -ne 3) { throw 'Invalid helper block' }; & ([scriptblock]::Create($f[1])); exit 0 } catch { Write-Host $_.Exception.Message -ForegroundColor Red; exit 1 }"
+exit /b %errorlevel%
+:saferohook:
+$ErrorActionPreference = 'Stop'
+if ($PSVersionTable.PSVersion -lt [version]'5.1') { throw 'This local safer build requires Windows PowerShell 5.1.' }
+$journalBlock = [IO.File]::ReadAllText($env:MAS_SAFE_SELF) -split '(?m)^:saferjournal:\r?$'
+if ($journalBlock.Count -ne 3) { throw 'Invalid recovery journal helper block.' }
+. ([scriptblock]::Create($journalBlock[1])) # Definitions only; plan/preflight creates no journal.
